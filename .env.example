# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SwiftCart — Environment Variables Template
# Copy this file to .env and fill in real values.
# ⚠️  NEVER commit .env to Git. It is already in .gitignore.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ── Existing Backend API (PHP) ────────────────────────────────
VITE_API_BASE_URL=https://your-api-base-url.example.com
VITE_API_TOKEN=YOUR_API_TOKEN_HERE

# ── Google Gemini AI ──────────────────────────────────────────
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ── EmailJS ───────────────────────────────────────────────────
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=aBcDeFgHiJkLmNoPq
VITE_EMAILJS_CONTACT_TEMPLATE_ID=template_yyyyyyy

# ── Razorpay (Client-side — SAFE to expose, this is the PUBLIC key) ──
# Get from Razorpay Dashboard → Settings → API Keys
# This is your KEY_ID (starts with rzp_test_ or rzp_live_)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx

# ── Razorpay Proxy (Vercel Serverless) ───────────────────────
# For LOCAL DEV: Leave empty — CheckoutView will call /api/* directly (relative URL)
# For PRODUCTION: Also leave empty — same domain, relative URLs work automatically.
# Only set this if you deploy the /api functions to a DIFFERENT domain than the frontend.
VITE_PAYMENT_PROXY_URL=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ⛔ The following are SERVER-ONLY — set ONLY in Vercel Dashboard
#    → Project → Settings → Environment Variables
#    DO NOT add RAZORPAY_KEY_SECRET here or to .env
#    It must NEVER have a VITE_ prefix (that would expose it in the bundle)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# RAZORPAY_KEY_ID      = rzp_test_xxxxxxxxxxxxxxxx   ← also add here (server reads it too)
# RAZORPAY_KEY_SECRET  = your_razorpay_key_secret    ← NEVER VITE_ prefix, NEVER in .env file
